rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedGoogle() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com'; }
  function owner() { return signedGoogle() && request.auth.token.email.lower() == 'porthachapong@gmail.com'; }
  function admin() { return owner() || (signedGoogle() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) && get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.active == true); }
  function str(s,n) { return s is string && s.size() <= n; }
  function required(s,n) { return str(s,n) && s.size() > 0; }
  function validDate(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
  function driver(id) { return get(/databases/$(database)/documents/drivers/$(id)).data; }
  match /admins/{email} {
   allow get: if signedGoogle() && (request.auth.token.email.lower() == email || owner());
   allow list: if owner();
   allow create, update: if owner() && email != 'porthachapong@gmail.com' && email == email.lower() && email.size() <= 254 && email.matches('^[^ /@]+@[^ /@]+[.][^ /@]+$') && request.resource.data.keys().hasOnly(['active', 'updatedBy', 'updatedAt']) && request.resource.data.active is bool && request.resource.data.updatedBy == request.auth.token.email.lower() && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  match /members/{uid} {
   allow get: if owner() || (signedGoogle() && request.auth.uid == uid);
   allow list: if owner();
   allow create, update: if signedGoogle() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['email','name','lastLoginAt']) && request.resource.data.email == request.auth.token.email.lower() && str(request.resource.data.name,100) && request.resource.data.lastLoginAt == request.time;
   allow delete: if false;
  }
  match /memberAudits/{id} {
   allow read: if owner();
   allow create: if owner() && request.resource.data.keys().hasOnly(['email','active','actor','createdAt']) && required(request.resource.data.email,254) && request.resource.data.active is bool && request.resource.data.actor == request.auth.token.email.lower() && request.resource.data.createdAt == request.time && getAfter(/databases/$(database)/documents/admins/$(request.resource.data.email)).data.active == request.resource.data.active;
   allow update, delete: if false;
  }
  match /settings/queue {
   allow read: if admin();
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['tailAt']) && request.resource.data.tailAt is int && (!exists(/databases/$(database)/documents/settings/queue) || request.resource.data.tailAt > resource.data.tailAt);
  }
  match /salesContacts/{id} {
   function valid() { let d = request.resource.data; return d.keys().hasOnly(['name','phone','details','createdAt','updatedAt']) && required(d.name,100) && d.name.matches('.*[^\\s].*') && d.phone is string && d.phone.matches('^0[1-9][0-9]{7,8}$') && str(d.details,2000) && d.createdAt is int && d.updatedAt is int && d.createdAt >= 0 && d.updatedAt >= d.createdAt; }
   allow read: if true;
   allow create: if admin() && valid();
   allow update: if admin() && valid() && request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if false;
  }
  match /drivers/{id} {
   function valid() { let d=request.resource.data; return d.keys().hasOnly(['name','plate','truckType','phone','active','activeJobId','createdAt','updatedAt']) && required(d.name,80) && required(d.plate,30) && required(d.truckType,50) && str(d.phone,30) && d.active is bool && str(d.activeJobId,100) && d.createdAt is int && d.updatedAt is int; }
   allow read: if true;
   allow create: if admin() && valid() && request.resource.data.activeJobId == '';
   allow update: if admin() && valid() && request.resource.data.createdAt == resource.data.createdAt && (request.resource.data.active || (request.resource.data.activeJobId == '' && !existsAfter(/databases/$(database)/documents/queue/$(id))));
   allow delete: if false;
  }
  match /queue/{id} {
   function validFields() { let d=request.resource.data; return d.keys().hasOnly(['driverId','driverName','plate','truckType','joinedAt','status']) && d.get('status', 'waiting') in ['waiting','heading']; }
   function valid() { let d=request.resource.data; return validFields() && d.driverId == id && d.driverName == driver(id).name && d.plate == driver(id).plate && d.truckType == driver(id).truckType && d.joinedAt is int && driver(id).active && driver(id).activeJobId == ''; }
   allow read: if true;
   allow create: if admin() && valid() && request.resource.data.joinedAt == getAfter(/databases/$(database)/documents/settings/queue).data.tailAt;
   allow update: if admin() && validFields() && request.resource.data.driverId == resource.data.driverId && (request.resource.data.joinedAt == resource.data.joinedAt || (request.resource.data.joinedAt > resource.data.joinedAt && request.resource.data.joinedAt == getAfter(/databases/$(database)/documents/settings/queue).data.tailAt)) && request.resource.data.driverName == getAfter(/databases/$(database)/documents/drivers/$(id)).data.name && request.resource.data.plate == getAfter(/databases/$(database)/documents/drivers/$(id)).data.plate && request.resource.data.truckType == getAfter(/databases/$(database)/documents/drivers/$(id)).data.truckType;
   allow delete: if admin();
  }
  match /jobs/{id} {
   function valid() { let d=request.resource.data; return d.keys().hasOnly(['driverId','driverName','plate','truckType','date','provinces','status','note','createdAt','updatedAt']) && required(d.driverId,100) && required(d.driverName,80) && required(d.plate,30) && required(d.truckType,50) && validDate(d.date) && d.provinces is list && d.provinces.size()>0 && d.provinces.size()<=8 && d.status in ['scheduled','running','completed','cancelled'] && str(d.note,300) && d.createdAt is int && d.updatedAt is int; }
   allow read: if true;
   allow create: if admin() && valid() && request.resource.data.status in ['scheduled','running'] && exists(/databases/$(database)/documents/queue/$(request.resource.data.driverId)) && !existsAfter(/databases/$(database)/documents/queue/$(request.resource.data.driverId)) && getAfter(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.activeJobId == id;
   allow update: if admin() && valid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && ((resource.data.status == 'scheduled' && request.resource.data.status in ['running','cancelled']) || (resource.data.status == 'running' && request.resource.data.status in ['completed','cancelled'])) && (request.resource.data.status == 'running' || getAfter(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.activeJobId != id);
   allow delete: if false;
  }
  match /entries/{id} {
   function valid() { let d=request.resource.data; return d.keys().hasOnly(['driverId','driverName','plate','kind','amount','date','recipient','description','status','evidenceCount','createdAt','updatedAt','cancellationId']) && required(d.driverId,100) && required(d.driverName,80) && required(d.plate,30) && d.kind in ['advance','expense','repair','deduction','replacement'] && d.amount is int && d.amount > 0 && d.amount <= 1000000000 && validDate(d.date) && required(d.recipient,100) && required(d.description,500) && d.status in ['pending','paid','void'] && d.evidenceCount is int && d.evidenceCount>=0 && d.evidenceCount<=3 && d.createdAt is int && d.updatedAt is int && (!('cancellationId' in d) || required(d.cancellationId,100)); }
   function cancellationLink() {
    let d = request.resource.data;
    let c = getAfter(/databases/$(database)/documents/cancellations/$(d.cancellationId)).data;
    return d.date == c.date && d.createdAt == c.createdAt && d.evidenceCount == 0 &&
      ((d.kind == 'deduction' && id == c.deductionEntryId && d.driverId == c.driverId &&
        d.driverName == c.driverName && d.plate == c.plate && d.amount == c.deductionAmount) ||
       (d.kind == 'replacement' && id == c.compensationEntryId && d.driverId == c.replacementDriverId &&
        d.driverName == c.replacementDriverName && d.plate == c.replacementPlate && d.amount == c.compensationAmount));
   }
   allow read: if true;
   allow create: if admin() && valid() && request.resource.data.status == 'pending' && exists(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)) && (('cancellationId' in request.resource.data) ? cancellationLink() : request.resource.data.kind != 'replacement');
   allow update: if admin() && valid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && ((resource.data.status=='pending' && request.resource.data.status in ['paid','void']) || (resource.data.status=='paid' && request.resource.data.status=='void'));
   allow delete: if false;
   match /evidence/{evidenceId} {
    allow read: if true;
    allow create: if admin() && !exists(/databases/$(database)/documents/entries/$(id)) && existsAfter(/databases/$(database)/documents/entries/$(id)) && request.resource.data.keys().hasOnly(['name','dataUrl']) && required(request.resource.data.name,120) && str(request.resource.data.dataUrl,600000) && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    allow update,delete: if false;
   }
  }
  match /cancellations/{id} {
   function amount(n) { return n is int && n >= 0 && n <= 1000000000; }
   function linkedEntry(entryId, driverId, kind, value) {
    let e = getAfter(/databases/$(database)/documents/entries/$(entryId)).data;
    return e.cancellationId == id && e.driverId == driverId && e.kind == kind &&
      e.amount == value && e.status == 'pending' && e.date == request.resource.data.date;
   }
   function replacement() {
    let d = request.resource.data;
    let j = getAfter(/databases/$(database)/documents/jobs/$(d.replacementJobId)).data;
    return d.replacementDriverId != d.driverId && d.replacementJobId == id + '_job' &&
      j.driverId == d.replacementDriverId && j.driverName == d.replacementDriverName &&
      j.plate == d.replacementPlate && j.date == d.replacementJobDate &&
      j.provinces == d.replacementProvinces &&
      j.status in ['running','scheduled'];
   }
   function valid() {
    let d = request.resource.data;
    let q = get(/databases/$(database)/documents/queue/$(d.driverId)).data;
    return d.keys().hasOnly(['driverId','driverName','plate','date','reason','replacementDriverId',
      'replacementDriverName','replacementPlate','replacementJobId','replacementJobDate','replacementProvinces',
      'deductionAmount','compensationAmount','deductionEntryId','compensationEntryId','actor','createdAt']) &&
      required(d.driverId,100) && d.driverName == q.driverName && d.plate == q.plate &&
      validDate(d.date) && required(d.reason,200) && d.actor == request.auth.token.email &&
      d.createdAt is int && amount(d.deductionAmount) && amount(d.compensationAmount) &&
      str(d.replacementDriverId,100) && str(d.replacementDriverName,80) && str(d.replacementPlate,30) &&
      str(d.replacementJobId,100) && str(d.replacementJobDate,10) && d.replacementProvinces is list &&
      str(d.deductionEntryId,100) && str(d.compensationEntryId,100) &&
      !existsAfter(/databases/$(database)/documents/queue/$(d.driverId)) &&
      (d.replacementDriverId == ''
        ? (d.replacementDriverName == '' && d.replacementPlate == '' && d.replacementJobId == '' &&
           d.replacementJobDate == '' && d.replacementProvinces.size() == 0 && d.compensationAmount == 0)
        : replacement()) &&
      (d.deductionAmount == 0 ? d.deductionEntryId == '' :
        (d.deductionEntryId == id + '_deduction' && linkedEntry(d.deductionEntryId, d.driverId, 'deduction', d.deductionAmount))) &&
      (d.compensationAmount == 0 ? d.compensationEntryId == '' :
        (d.compensationEntryId == id + '_replacement' && linkedEntry(d.compensationEntryId, d.replacementDriverId, 'replacement', d.compensationAmount)));
   }
   allow read: if true;
   allow create: if admin() && valid();
   allow update, delete: if false;
  }
  match /audits/{id} {
   allow read: if true;
   allow create: if admin() && request.resource.data.keys().hasOnly(['action','detail','actor','createdAt']) && required(request.resource.data.action,100) && str(request.resource.data.detail,1000) && request.resource.data.actor == request.auth.token.email && request.resource.data.createdAt is int;
   allow update,delete: if false;
  }
 }
}
