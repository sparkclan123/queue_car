rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedGoogle() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com'; }
  function admin() { return signedGoogle() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) && get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.active == true; }
  function str(s,n) { return s is string && s.size() <= n; }
  function required(s,n) { return str(s,n) && s.size() > 0; }
  function validDate(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
  function driver(id) { return get(/databases/$(database)/documents/drivers/$(id)).data; }
  match /admins/{email} {
   allow get: if signedGoogle() && (request.auth.token.email.lower() == email || admin());
   allow list: if admin();
   allow write: if false;
  }
  match /settings/queue {
   allow read: if admin();
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['tailAt']) && request.resource.data.tailAt is int && (!exists(/databases/$(database)/documents/settings/queue) || request.resource.data.tailAt > resource.data.tailAt);
  }
  match /drivers/{id} {
   function valid() { let d=request.resource.data; return d.keys().hasOnly(['name','plate','truckType','phone','active','activeJobId','createdAt','updatedAt']) && required(d.name,80) && required(d.plate,30) && required(d.truckType,50) && str(d.phone,30) && d.active is bool && str(d.activeJobId,100) && d.createdAt is int && d.updatedAt is int; }
   allow read: if admin();
   allow create: if admin() && valid() && request.resource.data.activeJobId == '';
   allow update: if admin() && valid() && request.resource.data.createdAt == resource.data.createdAt && (request.resource.data.active || (request.resource.data.activeJobId == '' && !existsAfter(/databases/$(database)/documents/queue/$(id))));
   allow delete: if false;
  }
  match /queue/{id} {
   function valid() { let d=request.resource.data; return d.keys().hasOnly(['driverId','driverName','plate','truckType','joinedAt']) && d.driverId == id && d.driverName == driver(id).name && d.plate == driver(id).plate && d.truckType == driver(id).truckType && d.joinedAt is int && driver(id).active && driver(id).activeJobId == ''; }
   allow read: if true;
   allow create: if admin() && valid() && request.resource.data.joinedAt == getAfter(/databases/$(database)/documents/settings/queue).data.tailAt;
   allow update: if admin() && request.resource.data.keys().hasOnly(['driverId','driverName','plate','truckType','joinedAt']) && request.resource.data.driverId == resource.data.driverId && (request.resource.data.joinedAt == resource.data.joinedAt || (request.resource.data.joinedAt > resource.data.joinedAt && request.resource.data.joinedAt == getAfter(/databases/$(database)/documents/settings/queue).data.tailAt)) && request.resource.data.driverName == getAfter(/databases/$(database)/documents/drivers/$(id)).data.name && request.resource.data.plate == getAfter(/databases/$(database)/documents/drivers/$(id)).data.plate && request.resource.data.truckType == getAfter(/databases/$(database)/documents/drivers/$(id)).data.truckType;
   allow delete: if admin();
  }
  match /jobs/{id} {
   function valid() { let d=request.resource.data; return d.keys().hasOnly(['driverId','driverName','plate','truckType','date','provinces','status','note','createdAt','updatedAt']) && required(d.driverId,100) && required(d.driverName,80) && required(d.plate,30) && required(d.truckType,50) && validDate(d.date) && d.provinces is list && d.provinces.size()>0 && d.provinces.size()<=8 && d.status in ['scheduled','running','completed','cancelled'] && str(d.note,300) && d.createdAt is int && d.updatedAt is int; }
   allow read: if true;
   allow create: if admin() && valid() && request.resource.data.status in ['scheduled','running'] && exists(/databases/$(database)/documents/queue/$(request.resource.data.driverId)) && !existsAfter(/databases/$(database)/documents/queue/$(request.resource.data.driverId)) && getAfter(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.activeJobId == id;
   allow update: if admin() && valid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && ((resource.data.status == 'scheduled' && request.resource.data.status in ['running','cancelled']) || (resource.data.status == 'running' && request.resource.data.status in ['completed','cancelled'])) && (request.resource.data.status == 'running' || getAfter(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.activeJobId != id);
   allow delete: if false;
  }
  match /entries/{id} {
   function valid() { let d=request.resource.data; return d.keys().hasOnly(['driverId','driverName','plate','kind','amount','date','recipient','description','status','evidenceCount','createdAt','updatedAt']) && required(d.driverId,100) && required(d.driverName,80) && required(d.plate,30) && d.kind in ['advance','expense','repair','deduction'] && d.amount is int && d.amount > 0 && d.amount <= 1000000000 && validDate(d.date) && required(d.recipient,100) && required(d.description,500) && d.status in ['pending','paid','void'] && d.evidenceCount is int && d.evidenceCount>=0 && d.evidenceCount<=3 && d.createdAt is int && d.updatedAt is int; }
   allow read: if admin();
   allow create: if admin() && valid() && request.resource.data.status == 'pending' && exists(/databases/$(database)/documents/drivers/$(request.resource.data.driverId));
   allow update: if admin() && valid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && ((resource.data.status=='pending' && request.resource.data.status in ['paid','void']) || (resource.data.status=='paid' && request.resource.data.status=='void'));
   allow delete: if false;
   match /evidence/{evidenceId} {
    allow read: if admin();
    allow create: if admin() && !exists(/databases/$(database)/documents/entries/$(id)) && existsAfter(/databases/$(database)/documents/entries/$(id)) && request.resource.data.keys().hasOnly(['name','dataUrl']) && required(request.resource.data.name,120) && str(request.resource.data.dataUrl,600000) && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    allow update,delete: if false;
   }
  }
  match /audits/{id} {
   allow read: if admin();
   allow create: if admin() && request.resource.data.keys().hasOnly(['action','detail','actor','createdAt']) && required(request.resource.data.action,100) && str(request.resource.data.detail,1000) && request.resource.data.actor == request.auth.token.email && request.resource.data.createdAt is int;
   allow update,delete: if false;
  }
 }
}
