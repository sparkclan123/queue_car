{
  "name": "queue-car",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-queue-car --only firestore 'vitest run --config vitest.rules.config.ts'",
    "deploy": "npm run build && firebase deploy --only firestore,hosting"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.2.0",
    "firebase": "^12.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.16.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
